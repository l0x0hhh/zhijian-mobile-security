  "sources": [
    {
      "id": "photo-permission.source.details",
      "kind": "AppDetails",
      "title": "应用详情",
      "body": "简像证件照。功能：拍摄或选一张照片，调整背景并裁切。开发者：个人开发者。来源：本地模拟文件页。状态：待启用（教学模拟）。",
      "requiredForBackground": true,
      "mediaId": null
    },
    {
      "id": "photo-permission.source.developer",
      "kind": "AppDetails",
      "title": "开发者资料",
      "body": "未提供可核实的主体名称和联系方式。",
      "requiredForBackground": false,
      "mediaId": null
    },
    {
      "id": "photo-permission.source.distribution",
      "kind": "Background",
      "title": "分发来源",
      "body": "案例本地模拟文件页，发布者未核实，不下载、不联网。",
      "requiredForBackground": false,
      "mediaId": null
    },
    {
      "id": "photo-permission.source.policy",
      "kind": "PrivacyPolicy",
      "title": "隐私政策",
      "body": "虚构政策，仅供练习。\n\n照片处理需要一张图片。你可以拍摄，也可以只选择一张现有照片。\n\n为改进服务，我们可以读取通讯录、短信、位置和相册中的全部照片，并用于关联分析。\n\n即使退出编辑，也须允许持续后台运行；拒绝后将无法制作证件照。",
      "requiredForBackground": true,
      "mediaId": null
    },
    {
      "id": "photo-permission.source.permissions",
      "kind": "PermissionDeclaration",
      "title": "访问声明",
      "body": "先选择用途，再判断每项访问。七项初始均待判断，阅读不等于同意。",
      "requiredForBackground": false,
      "mediaId": null
    },
    {
      "id": "photo-permission.source.reference",
      "kind": "Background",
      "title": "独立来源目录",
      "body": "案例对照资料：没有找到与发布者相符的主体和可信发布记录，来源仍无法核实；不是现实应用商店查询。",
      "requiredForBackground": false,
      "mediaId": null
    },
    {
      "id": "photo-permission.policy.function",
      "kind": "PrivacyPolicy",
      "title": "照片功能",
      "body": "照片处理需要一张图片。你可以拍摄，也可以只选择一张现有照片。",
      "requiredForBackground": false,
      "mediaId": null
    },
    {
      "id": "photo-permission.policy.collection",
      "kind": "PrivacyPolicy",
      "title": "收集与关联分析",
      "body": "为改进服务，我们可以读取通讯录、短信、位置和相册中的全部照片，并用于关联分析。",
      "requiredForBackground": false,
      "mediaId": null
    },
    {
      "id": "photo-permission.policy.background",
      "kind": "PrivacyPolicy",
      "title": "持续后台要求",
      "body": "即使退出编辑，也须允许持续后台运行；拒绝后将无法制作证件照。",
      "requiredForBackground": false,
      "mediaId": null
    },
    {
      "id": "photo-permission.source.permission.contacts",
      "kind": "PermissionDeclaration",
      "title": "通讯录用途",
      "body": "应用声称读取通讯录用于推荐分享对象。",
      "requiredForBackground": false,
      "mediaId": null
    },
    {
      "id": "photo-permission.source.permission.sms",
      "kind": "PermissionDeclaration",
      "title": "短信用途",
      "body": "应用声称读取短信用于自动验证账号。",
      "requiredForBackground": false,
      "mediaId": null
    },
    {
      "id": "photo-permission.source.permission.background",
      "kind": "PermissionDeclaration",
      "title": "后台运行用途",
      "body": "应用声称后台运行用于持续优化照片；拒绝持续后台就无法制作照片。",
      "requiredForBackground": false,
      "mediaId": null
    }
